{
  "expo": {
    "name": "ArcRadius - Policy Navigator",
    "slug": "arc-radius-ui",
    "scheme": "arc-radius",
    "version": "1.0.0",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "ArcRadius - Policy Navigator",
      "description": "Track LGBTQ+ legislation across all 50 states. Understand bills, take action, and stay informed.",
      "themeColor": "#18181b"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": ["expo-font", "expo-router"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    }
  }
}
